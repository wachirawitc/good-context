datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  id         String     @id @default(cuid())
  customerId String
  createdAt  DateTime   @default(now())
  items      LineItem[]
}

model LineItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  sku     String
  cents   Int
}
